# Debe coincidir con las variables de PostgreSQL del .env de la raíz.
# Contraseña ficticia para desarrollo local, no utilizar en otros entornos.
DATABASE_URL=postgresql+psycopg://reclamos:solo_desarrollo@127.0.0.1:5432/reclamos
APP_NAME=Gestión de reclamos — Prototipo académico
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# "memoria": funciona sin PostgreSQL y se reinicia con el servidor.
# "sql": reservado hasta que existan los repositorios con PostgreSQL.
ALMACENAMIENTO=memoria
CARGAR_DATOS_DEMO=true

# Clave ficticia de desarrollo. Generar una propia, de 32 caracteres o más, con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=solo-desarrollo-cambiar-esta-clave-jwt-2026
JWT_MINUTOS_EXPIRACION=480

# Reglas de plazo del prototipo (propuesta): días corridos.
PLAZO_DIAS=20
DIAS_ALERTA=3
ZONA_HORARIA=America/Santiago
