# Define la conexión solo si vas a usar PostgreSQL o ejecutar migraciones.
# DATABASE_URL=
APP_NAME=Gestión de reclamos — Prototipo académico
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# "memoria": funciona sin PostgreSQL y se reinicia con el servidor.
# "sql": reservado hasta que existan los repositorios con PostgreSQL.
ALMACENAMIENTO=memoria
CARGAR_DATOS_DEMO=false
# Define una contraseña propia de al menos 16 caracteres al habilitar la demo.
# CONTRASENA_DEMO=

# Define una clave propia para conservar sesiones entre reinicios.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
JWT_MINUTOS_EXPIRACION=480

# Reglas de plazo del prototipo (propuesta): días corridos.
PLAZO_DIAS=20
DIAS_ALERTA=3
ZONA_HORARIA=America/Santiago
